# ── VulnEdge Bridge configuration ───────────────────────────────────────────
# Copy to server/.env and edit. Never commit the filled-in file.

# HTTP
PORT=8787
# Comma-separated allowed origins for CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Authorization ────────────────────────────────────────────────────────────
# Shared bearer token the frontend must send as `Authorization: Bearer <token>`.
# Generate one:  openssl rand -hex 32
# If unset, the bridge runs OPEN on loopback only and refuses non-local clients.
BRIDGE_TOKEN=

# ── Safety posture (READ THIS) ────────────────────────────────────────────────
# SAFE_MODE=true  → exploitation stage PLANS and generates PoCs only; nothing is
#                   ever executed against the target. This is the default and the
#                   only supported posture out of the box.
#
# Setting SAFE_MODE=false does NOT by itself enable real exploitation — the
# exploitation provider still refuses to execute unless an operator has wired a
# real, authorized execution backend AND set ALLOW_ACTIVE_EXPLOIT=true. Both
# gates plus per-engagement authorization are required. Leave this alone unless
# you own the targets and have written authorization.
SAFE_MODE=true
ALLOW_ACTIVE_EXPLOIT=false

# ── Engagement scope (defense-in-depth) ───────────────────────────────────────
# Comma-separated allow-list of scannable targets: exact hosts, domains
# (a leading dot matches subdomains, e.g. .example.com), IPs, or CIDRs.
# A target outside this list is rejected before any tool runs. Empty = the
# operator must declare scope per engagement via the API (recommended).
SCOPE_ALLOWLIST=cecureintel.com,https://soc-scalable-infra-nlb-3d0f3e0030cc246e.elb.us-east-1.amazonaws.com/
# Block RFC1918 / loopback / link-local / metadata targets even if in scope.
BLOCK_PRIVATE_RANGES=true

# ── Tool provider ──────────────────────────────────────────────────────────────
# simulation → reuse the local VulnEdge engine (no packets leave the host).
# mcp        → drive real MCP servers declared in mcp.servers.json.
TOOL_PROVIDER=simulation
MCP_CONFIG_PATH=./mcp.servers.json

# ── LLM analysis (Ollama — primary) ─────────────────────────────────────────
# OpenAI-compatible endpoint for local Ollama. No API key required by default.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
# Optional bearer token if your Ollama proxy requires authentication.
LLM_API_KEY=

# MCP tool call timeout in milliseconds (default 600000 = 10 minutes).
MCP_REQUEST_TIMEOUT_MS=600000

# Per-source requests/minute cap.
RATE_LIMIT_PER_MIN=60
